# GROQ_API_KEY: Required for AI chat completions via Groq SDK.
# Get yours at https://console.groq.com/keys
# IMPORTANT: When deploying to Vercel, set this in the Vercel Dashboard under
# Settings > Environment Variables. Do NOT rely on .env in production.
GROQ_API_KEY="your_groq_api_key_here"

# APP_URL: The URL where this applet is hosted.
APP_URL="https://theinkhome.live"
